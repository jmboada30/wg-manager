# wg-manager - configuracion
# Copia este fichero a .env y ajusta los valores.
#   cp .env.example .env && chmod 600 .env
# El .env NUNCA se sube a git.

# --- Interfaz y rutas ---------------------------------------------------
WG_INTERFACE=wg0
WG_CONF=/etc/wireguard/wg0.conf
CLIENTS_DIR=/opt/wg-manager/clients
LOCK_FILE=/run/lock/wg-manager.lock

# --- Red de la VPN ------------------------------------------------------
# Obligatoria. Elige octetos poco comunes y aleatorios: las redes 10.0.x,
# 10.8.x y 10.10.x chocan a menudo con VPN corporativas, hoteles y routers
# 4G. En split tunnel, una colision te deja sin acceso a la red local.
WG_SUBNET=10.0.0.0/24

# IP del servidor dentro de la VPN. Por defecto, la primera de la subred.
WG_SERVER_IP=10.0.0.1

# Ultimo octeto a partir del cual se reparten IPs a clientes.
CLIENT_IP_START=2

# --- Datos que se escriben en el .conf de cada cliente ------------------
# Obligatorio: IP o dominio publico por el que los clientes alcanzan al
# servidor. Debe coincidir con el ListenPort de la interfaz.
SERVER_ENDPOINT=vpn.ejemplo.com
SERVER_PORT=51820

# Rutas que el cliente mete en el tunel.
# Solo la VPN (split tunnel) = el resto de su trafico sale por su red normal.
# Para varias rutas, separalas por comas: 10.0.0.0/24,192.168.50.0/24
CLIENT_ALLOWED_IPS=10.0.0.0/24

# Vacio = no se escribe la linea DNS.
# Cuidado: fijar un DNS con split tunnel manda TODAS las consultas del cliente
# por el tunel y suele romper la resolucion de su red local.
CLIENT_DNS=

CLIENT_KEEPALIVE=25

# Mascara del Address del cliente: 32 es lo correcto.
# 24 existe solo por compatibilidad con despliegues antiguos.
CLIENT_ADDRESS_PREFIX=32
